{
  "name": "imcf",
  "private": false,
  "version": "0.0.12",
  "author": "Tejas-H5",
  "description": "An immediate-mode wrapper over the DOM. But in theory, over anything at all",
  "type": "module",
  "scripts": {
    "dev": "node ./build/build.ts devserver",
    "build": "node ./build/build.ts build",
    "test": "node ./build/test.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tejas-H5/imjs.git"
  },
  "keywords": [
    "immediate-mode",
    "immediate-mode control-flow"
  ],
  "licence": "MIT",
  "devDependencies": {
    "@types/node": "^25.3.2",
    "@typescript/native-preview": "^7.0.0-dev.20260227.1",
    "domino": "^2.1.7",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "import": "./src/imcf/index.ts",
      "types": "./src/imcf/index.ts"
    },
    "./im-ui": {
      "import": "./src/imcf/im-ui/index.ts",
      "types": "./src/imcf/im-ui/index.ts"
    },
    "./im-ui/components/*": {
      "import": "./src/imcf/im-ui/components/*.ts",
      "types": "./src/imcf/im-ui/components/*.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/imcf"
  ]
}
